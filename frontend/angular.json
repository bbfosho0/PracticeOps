{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "practiceops": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/practiceops",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css", "src/visual-polish.css", "src/visual-layout-fixes.css", "src/visual-mobile-nav-fix.css", "src/functional-telemetry.css", "src/functional-layout-fixes.css", "src/responsive-telemetry.css"]
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": { "buildTarget": "practiceops:build" },
          "configurations": { "production": { "buildTarget": "practiceops:build:production" } }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "styles": ["src/styles.css", "src/visual-polish.css", "src/visual-layout-fixes.css", "src/visual-mobile-nav-fix.css", "src/functional-telemetry.css", "src/functional-layout-fixes.css", "src/responsive-telemetry.css"],
            "browsers": "ChromeHeadless"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "practiceops:build",
            "compodoc": false,
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "practiceops:build",
            "compodoc": false,
            "outputDir": "storybook-static"
          }
        }
      }
    }
  }
}
