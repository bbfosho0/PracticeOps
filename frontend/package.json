{
  "name": "practiceops-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "storybook": "ng run practiceops:storybook",
    "build-storybook": "ng run practiceops:build-storybook",
    "test-storybook": "test-storybook --url http://127.0.0.1:6006 --maxWorkers=2",
    "api:generate": "node ../scripts/generate-api-client.mjs",
    "api:check": "node ../scripts/generate-api-client.mjs --check",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@angular/animations": "20.3.27",
    "@angular/common": "20.3.27",
    "@angular/compiler": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/forms": "20.3.27",
    "@angular/platform-browser": "20.3.27",
    "@angular/platform-browser-dynamic": "20.3.27",
    "@angular/router": "20.3.27",
    "@formkit/auto-animate": "0.10.0",
    "gsap": "3.15.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.32",
    "@angular/cli": "20.3.32",
    "@angular/compiler-cli": "20.3.27",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "9.1.20",
    "@storybook/angular": "9.1.20",
    "@storybook/test-runner": "0.23.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jasmine": "5.1.8",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "jasmine-core": "5.9.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "postcss": "8.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "9.1.20",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2"
  }
}
